# ============================================
# BIZTRACKR V2 - EMAIL + LICENSE SYSTEM
# Environment Configuration
# ============================================

# -----------------------------------------
# 🔑 RESEND EMAIL API
# -----------------------------------------
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Make sure to verify your domain in Resend:
# https://resend.com/domains
# Sender email must be: noreply@biztrackr.com
# Or use: noreply@yourdomain.com (after verification)

# -----------------------------------------
# 💳 PAYMENT PROVIDER CONFIGS (Optional)
# -----------------------------------------

# Instamojo (India)
INSTAMOJO_API_KEY=your_instamojo_api_key
INSTAMOJO_AUTH_TOKEN=your_instamojo_auth_token
INSTAMOJO_WEBHOOK_SECRET=your_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_MODE=sandbox  # or 'live' for production

# -----------------------------------------
# 🗄️ DATABASE (Already configured)
# -----------------------------------------
# Your existing PostgreSQL or MongoDB connection
DATABASE_URL=postgresql+asyncpg://user:password@localhost/biztrackr

# -----------------------------------------
# 🌐 APPLICATION URLS
# -----------------------------------------
# Used for email links
FRONTEND_URL=https://biztrackr.com
BACKEND_URL=https://api.biztrackr.com

# -----------------------------------------
# 📧 EMAIL TEMPLATES CONFIG
# -----------------------------------------
# VENDOR: Configure your email settings here
# See GMAIL_EMAIL_SETUP.md for all options
EMAIL_FROM=BizTrackr <noreply@yourdomain.com>
EMAIL_SENDER_NAME=BizTrackr
EMAIL_SENDER_ADDRESS=noreply@yourdomain.com
